# Registry/network settings (read by both pnpm and npm).
# pnpm-specific settings live in pnpm-workspace.yaml — pnpm 11+ ignores them here.

# Enforce official registry (prevent typosquatting via alternate registries)
registry=https://registry.npmjs.org/

# Strict SSL validation
strict-ssl=true

# npm equivalents, in case npm is ever run in this directory
ignore-scripts=true
audit-level=high
min-release-age=7
